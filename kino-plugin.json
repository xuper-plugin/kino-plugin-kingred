{
  "id": "kingred",
  "name": "KingRed",
  "version": "0.1.0",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Catálogo de películas y series de KingRed: búsqueda, Inicio, fichas y temporadas, con reproducción delegada al motor kino-resolver.",
  "descriptionEn": "KingRed movies and series catalog: search, Home, title pages and seasons, with playback delegated to the kino-resolver engine.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-kingred",
  "hosts": [
    "st.kinghydra.site",
    "identitytoolkit.googleapis.com",
    "firebasestorage.googleapis.com",
    "image.tmdb.org"
  ],
  "capabilities": [
    "search",
    "home",
    "resolve",
    "episodes",
    "screen"
  ],
  "browser": true,
  "streamHosts": "any",
  "categories": [
    "movies",
    "series"
  ],
  "color": "#DC2626",
  "screen": {
    "label": "KingRed",
    "labelEn": "KingRed",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu"
    ]
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ]
}

{
  "id": "kingred",
  "name": "KingRed",
  "version": "0.1.0",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series de KingRed — catálogo público resuelto con Kino Resolver (Latino, Castellano y Subtitulado).",
  "descriptionEn": "KingRed movies and series — public catalog resolved with Kino Resolver (Latino, Castilian and Subtitled).",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-kingred",
  "hosts": [
    "st.kinghydra.site",
    "identitytoolkit.googleapis.com",
    "firebasestorage.googleapis.com",
    "image.tmdb.org",
    "ok.ru",
    "vidara.to",
    "audinifer.com",
    "hanerix.com",
    "filelions.to",
    "filelions.top",
    "filelions.com",
    "streamwish.to",
    "streamwish.com",
    "strwish.com",
    "embedwish.com",
    "wishembed.com",
    "hlswish.com",
    "vibuxer.com",
    "vidhide.com",
    "vidhidepro.com",
    "doodstream.com",
    "filemoon.sx",
    "disk.yandex.com"
  ],
  "capabilities": [
    "search",
    "home",
    "resolve",
    "episodes",
    "screen"
  ],
  "browser": true,
  "streamHosts": "any",
  "categories": [
    "movies",
    "series"
  ],
  "color": "#F5455C",
  "theme": {
    "accent": "#F5455C",
    "onAccent": "#1A0205",
    "background": "#0C0608",
    "surface": "#1F0C10",
    "highlight": "#FF5A66"
  },
  "settings": [
    {
      "key": "audioSection",
      "type": "section",
      "label": "Idioma",
      "labelEn": "Language",
      "hint": "Cada título puede traer varios idiomas; Kino abre primero el que elijas y, si falla, los demás.",
      "hintEn": "A title may come in several languages; Kino opens the one you pick first and, if it fails, the others."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino",
          "labelEn": "Latino"
        },
        {
          "value": "cast",
          "label": "Castellano",
          "labelEn": "Castilian"
        },
        {
          "value": "sub",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ]
    },
    {
      "key": "info",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché?",
      "confirmEn": "Clear the cache?"
    }
  ],
  "screen": {
    "label": "KingRed",
    "labelEn": "KingRed",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir KingRed",
      "labelEn": "Open KingRed"
    },
    "settingsIn": "both"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve",
        "normalizeHost"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ]
}
